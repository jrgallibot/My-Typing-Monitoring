{
  "expo": {
    "name": "MyTypingMonitor",
    "slug": "mytypingmonitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mytypingmonitor"
    },
    "android": {
      "package": "com.mytypingmonitor",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "BIND_INPUT_METHOD",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "QUERY_ALL_PACKAGES",
        "PACKAGE_USAGE_STATS"
      ]
    },
    "web": {},
    "plugins": [
      "expo-dev-client"
    ],
    "scheme": "mytypingmonitor",
    "extra": {
      "eas": {
        "projectId": "b2e1f7a7-77ff-4ba6-9e24-2af798a4bfbc"
      }
    },
    "owner": "dswddevopscursor"
  }
}
