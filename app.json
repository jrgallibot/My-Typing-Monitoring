{
  "expo": {
    "name": "MyTypingMonitor",
    "slug": "mytypingmonitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mytypingmonitor"
    },
    "android": {
      "package": "com.mytypingmonitor",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BIND_INPUT_METHOD",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "QUERY_ALL_PACKAGES"
      ]
    },
    "web": {},
    "plugins": [
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "b059788f-f0b6-42db-b4a7-fede235cc3fa"
      }
    }
  }
}
